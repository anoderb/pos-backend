# =================================================================
# TOKIVA POS BACKEND — ENVIRONMENT VARIABLES (.env.example)
# =================================================================

# -----------------------------------------------------------------
# SERVER CONFIGURATION
# -----------------------------------------------------------------
NODE_ENV=development
PORT=5000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000,https://tokiva.biz.id,https://app.tokiva.biz.id,https://www.tokiva.biz.id

# -----------------------------------------------------------------
# DATABASE & SUPABASE CONFIGURATION
# -----------------------------------------------------------------
# URL proyek Supabase Anda
SUPABASE_URL=https://your-supabase-project.supabase.co

# Supabase Anonymous Key (Client)
SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Service Role Key (Server/Admin bypass RLS)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# PostgreSQL Connection String (Direct Connection)
DATABASE_URL=postgresql://postgres:your-db-password@db.your-supabase-project.supabase.co:5432/postgres

# -----------------------------------------------------------------
# JWT & SECURITY CONFIGURATION
# -----------------------------------------------------------------
# Secret key untuk verifikasi token JWT
JWT_SECRET=tokiva-super-secret-jwt-key-change-this-in-production-2026
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# -----------------------------------------------------------------
# SUPABASE STORAGE BUCKETS
# -----------------------------------------------------------------
BUCKET_TOKO_LOGO=toko-logos
BUCKET_TOKO_QRIS=toko-qris
BUCKET_NOTA_MASUK=nota-masuk-foto
BUCKET_BUKTI_HUTANG=bukti-pembayaran-hutang
BUCKET_AI_DATASET=dataset-foto-ai

# -----------------------------------------------------------------
# EMAIL SERVICE (RESEND)
# -----------------------------------------------------------------
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=Tokiva POS <noreply@tokiva.id>
