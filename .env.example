# =================================================================
# WebPOS BACKEND — ENVIRONMENT VARIABLES (.env.example)
# =================================================================

# -----------------------------------------------------------------
# SERVER CONFIGURATION
# -----------------------------------------------------------------
NODE_ENV=development
PORT=5000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# -----------------------------------------------------------------
# DATABASE & SUPABASE CONFIGURATION
# -----------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_PROJECT_REF=your-project-ref
DATABASE_URL=postgresql://postgres:***@db.your-project.supabase.co:5432/postgres

# -----------------------------------------------------------------
# JWT & SECURITY
# -----------------------------------------------------------------
JWT_SECRET=change-this-in-production
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# -----------------------------------------------------------------
# SUPABASE STORAGE BUCKETS
# -----------------------------------------------------------------
BUCKET_TOKO_LOGO=toko-logos
BUCKET_TOKO_QRIS=toko-qris
BUCKET_NOTA_MASUK=nota-masuk-foto
BUCKET_BUKTI_HUTANG=bukti-pembayaran-hutang
BUCKET_AI_DATASET=dataset-foto-ai

# -----------------------------------------------------------------
# EMAIL SERVICE (RESEND)
# -----------------------------------------------------------------
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=WebPOS <noreply@your-domain.com>

# -----------------------------------------------------------------
# HUGGINGFACE (AI training dataset)
# -----------------------------------------------------------------
HF_TOKEN=
HF_REPO=your-org/dataset-collect

# -----------------------------------------------------------------
# KAGGLE (AI model training)
# -----------------------------------------------------------------
KAGGLE_USERNAME=
KAGGLE_KEY=
